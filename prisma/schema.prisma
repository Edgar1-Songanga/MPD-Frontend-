generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  email     String
  industry  String?
  createdAt DateTime @default(now())

  users      User[]
  candidates Candidate[]
  jobs       Job[]
}

model User {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  role      Role
  companyId String?

  company Company? @relation(fields: [companyId], references: [id])
}

model Candidate {
  id         String @id @default(cuid())
  fullName   String
  email      String
  phone      String?
  skills     String?
  experience String?
  companyId  String?

  company Company? @relation(fields: [companyId], references: [id])
}

model Job {
  id          String @id @default(cuid())
  title       String
  description String
  sector      String?
  active      Boolean @default(true)
  companyId   String?

  company Company? @relation(fields: [companyId], references: [id])
}

enum Role {
  ADMIN
  HR
  CLIENT
  USER
}
